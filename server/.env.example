PORT=3001

# Required once this server is reachable over the network (e.g. the Docker/
# self-hosted "online" version) rather than just localhost. Every /api
# request must then send "Authorization: Bearer <this value>". Leave blank
# for local dev - generate a real one with: openssl rand -hex 32
APP_ACCESS_TOKEN=

# "mock" (default, safe synthetic data) or "facebook" (real Playwright automation,
# requires running `npm run fb:login` first - see README for the tradeoffs).
MARKETPLACE_PROVIDER=mock

# How far apart (miles) to search along the route, and a hard cap on how many
# searches a single trip can trigger.
WAYPOINT_INTERVAL_MILES=25
MAX_WAYPOINTS=15

# Facebook provider tuning (only used when MARKETPLACE_PROVIDER=facebook)
FB_STORAGE_STATE_PATH=./.data/fb-storage-state.json
FB_HEADLESS=true
FB_MIN_DELAY_MS=4000
FB_MAX_DELAY_MS=8000
FB_NAV_TIMEOUT_MS=30000

NOMINATIM_USER_AGENT=fb-marketplace-route-search/1.0 (personal project)
